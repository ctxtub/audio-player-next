// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id               Int                   @id @default(autoincrement())
  username         String                @unique
  password         String
  nickname         String?
  createdAt        DateTime              @default(now())
  config           UserConfig?
  promptHistory    PromptHistory[]
  storyWorks       StoryWork[]
  chatMessages     ChatMessage[]
  conversations    Conversation[]
  storyCollections StoryCollection[]
  playbackAnchor    UserPlaybackAnchor?
  storyWorkMigrations StoryWorkMigration[]
}

/// 创作会话（User 侧；一会话一作品集，§2 首作建集）。id 为 service 生成的 UUID 文本，无 DB 默认。
model Conversation {
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 状态：active | closed（一主体至多一个 active，由服务事务 + 部分唯一索引保证）
  state     String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collections  StoryCollection[]
  chatMessages ChatMessage[]

  @@index([userId, state])
  @@index([updatedAt])
}

/// 创作作品集（User 侧；会话 1:1）。id 为 service 生成的 UUID 文本。
model StoryCollection {
  id             String       @id
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String       @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// AI / 用户标题（存储上限 80 code points）
  title          String       @default("")
  /// 标题来源：ai | fallback | user（user 后自动流程不得覆盖）
  titleSource    String       @default("fallback")
  /// 收藏时间（NULL 表示未收藏）
  favoritedAt    DateTime?
  /// 软删除时间（NULL 表示未删除）
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  works StoryWork[]

  @@index([userId, deletedAt])
  @@index([userId, favoritedAt])
  @@index([userId, createdAt, id])
  @@index([updatedAt])
}

/// 访客创作会话（与 Conversation 对称；guestId 索引 + updatedAt GC 索引）。
model GuestConversation {
  id        String   @id
  guestId   String
  /// 状态：active | closed
  state     String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collections  GuestStoryCollection[]
  chatMessages GuestChatMessage[]

  @@index([guestId, state])
  @@index([guestId])
  @@index([updatedAt])
}

/// 访客创作作品集（与 StoryCollection 对称）。
model GuestStoryCollection {
  id             String            @id
  guestId        String
  conversationId String            @unique
  conversation   GuestConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  title          String            @default("")
  titleSource    String            @default("fallback")
  favoritedAt    DateTime?
  deletedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  works GuestStoryWork[]

  @@index([guestId, deletedAt])
  @@index([guestId, favoritedAt])
  @@index([guestId, createdAt, id])
  @@index([guestId])
  @@index([updatedAt])
}

/// 用户当前聊天会话的消息（单会话快照），与 User 多对一关联。
model ChatMessage {
  id        Int     @id @default(autoincrement())
  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 所属创作会话（M9-C1 expand：旧行为 NULL，backfill 后归属 legacy Conversation）
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  /// 会话内顺序
  position  Int
  /// 前端消息 id
  messageId String
  role      String
  content   String
  /// JSON 序列化的 parts（storyCard 的 audioUrl 已置空）
  parts     String?
  /// Agent 类型
  agentType String?
  /// 前端 createdAt ISO 字符串（展示用）
  createdAt String?

  @@unique([conversationId, position])
  @@unique([conversationId, messageId])
  @@index([userId, position])
  @@index([conversationId, position])
}

/// 用户作品表（逻辑名 StoryWork，物理表仍为 GenerationHistory），与 User 多对一关联。
model StoryWork {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("userId")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 触发生成的提示词
  prompt          String
  /// 生成的故事正文
  storyText       String
  /// 生成时使用的音色（回放优先用它）
  voiceId         String    @default("")
  /// 作品标题（未来可由用户编辑）
  title           String    @default("")
  /// 摘要（截取正文前 N 字）
  excerpt         String    @default("")
  /// 正文内容哈希
  contentHash     String    @default("")
  /// 来源消息 ID（关联 ChatMessage.messageId，NULL 表示 legacy 数据）
  sourceMessageId String?
  /// 所属作品集（M9-C1 expand：NULL 表示 legacy 未归属，backfill 后一 Work 一 Collection）
  collectionId    String?
  collection      StoryCollection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  /// 集合内稳定顺序（M9-C1 expand：NULL 表示 legacy；同集合唯一）
  position        Int?
  /// 收藏时间（NULL 表示未收藏）
  favoritedAt     DateTime?
  /// 软删除时间（NULL 表示未删除）
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  /// 每作品长期播放进度（per-Work 0/1；ownership 经本表 → User，不重复存 userId）
  progress        StoryPlaybackProgress?
  /// M8 Canonical Audio Manifests（按 version 共存；旧 Work 无 Manifest = audio.status missing，不回填）
  audioManifests  StoryAudioManifest[]
  /// M9-C1 T3 单轨资产（一 Work 一 canonical track；expand-only，旧 Segment 保留）
  audioAssets     StoryAudioAsset[]
  /// M9-C1 T3 秒级播放进度（per-Work 0/1）
  audioProgress   StoryAudioProgress?

  @@unique([userId, sourceMessageId])
  @@unique([collectionId, position])
  @@unique([collectionId, sourceMessageId])
  @@index([userId, createdAt, id])
  @@index([userId, deletedAt])
  @@index([userId, favoritedAt])
  @@index([collectionId, position])
  @@map("GenerationHistory")
}

/// 用户提示词使用历史，与 User 多对一关联。
model PromptHistory {
  id       Int      @id @default(autoincrement())
  userId   Int
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 提示词原文
  prompt   String
  /// 最近一次使用时间
  lastUsed DateTime
  /// 累计使用次数
  useCount Int      @default(1)

  @@unique([userId, prompt])
}

/// 用户个性化配置，与 User 一对一关联。
model UserConfig {
  id                    Int      @id @default(autoincrement())
  userId                Int      @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// M7-03 默认睡眠定时分钟数（逻辑 rename；物理列仍为 playDurationMinutes，不做 SQLite rebuild；范围 10-120）
  defaultSleepTimerMinutes   Int      @default(30) @map("playDurationMinutes")
  /// M7-03 默认睡眠定时开关（true=新 Session 默认 minutes 定时；false=新 Session 默认 off；默认 true 保持既有 30 分钟行为，§29.2）
  defaultSleepTimerEnabled Boolean @default(true)
  /// TTS 音色 ID，空字符串表示使用系统默认
  voiceId               String   @default("")
  /// 播放速率，范围 0.25-4.0，默认 1.0
  speed                 Float    @default(1.0)
  /// 是否在宽屏启用悬浮迷你播放器（M6 领域语义；false=wide-docked，物理列仍为 floatingPlayerEnabled，不做 migration）
  desktopFloatingPlayerEnabled Boolean  @default(true) @map("floatingPlayerEnabled")
  /// 主题模式：dark | light | system
  themeMode             String   @default("system")
  /// 预留扩展字段，存储 JSON 格式的未来配置项
  extras                String?
  updatedAt             DateTime @updatedAt
}

/// 访客个性化配置表，以具名访客标识 guestId 为唯一索引。
model GuestConfig {
  id                    Int      @id @default(autoincrement())
  /// 具名访客标识符（格式如 g_1234567890abcdef...）
  guestId               String   @unique
  /// M7-03 默认睡眠定时分钟数（逻辑 rename；物理列仍为 playDurationMinutes；范围 10-120）
  defaultSleepTimerMinutes   Int      @default(30) @map("playDurationMinutes")
  /// M7-03 默认睡眠定时开关（默认 true 保持既有行为，§29.2）
  defaultSleepTimerEnabled Boolean @default(true)
  /// TTS 音色 ID，空字符串表示使用系统默认
  voiceId               String   @default("")
  /// 播放速率，范围 0.25-4.0，默认 1.0
  speed                 Float    @default(1.0)
  /// 是否在宽屏启用悬浮迷你播放器（M6 领域语义；false=wide-docked，物理列仍为 floatingPlayerEnabled，不做 migration）
  desktopFloatingPlayerEnabled Boolean  @default(true) @map("floatingPlayerEnabled")
  /// 主题模式：dark | light | system
  themeMode             String   @default("system")
  /// 预留扩展字段，存储 JSON 格式的配置项
  extras                String?
  /// 最后更新时间，用于清理策略索引
  updatedAt             DateTime @updatedAt
  /// 创建时间
  createdAt             DateTime @default(now())

  @@index([guestId])
  @@index([updatedAt])
}

/// 访客聊天会话消息表（单会话快照，以具名访客 guestId 索引）
model GuestChatMessage {
  id        Int      @id @default(autoincrement())
  guestId   String
  /// 所属访客创作会话（M9-C1 expand：旧行为 NULL）
  conversationId String?
  conversation   GuestConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  position  Int
  messageId String
  role      String
  content   String
  parts     String?
  agentType String?
  createdAt String?
  updatedAt DateTime @updatedAt

  @@unique([conversationId, position])
  @@unique([conversationId, messageId])
  @@index([guestId, position])
  @@index([guestId])
  @@index([updatedAt])
  @@index([conversationId, position])
}

/// 访客作品表（逻辑名 GuestStoryWork，物理表仍为 GuestGenerationHistory）
model GuestStoryWork {
  id              Int       @id @default(autoincrement())
  guestId         String
  prompt          String
  storyText       String
  voiceId         String    @default("")
  /// 作品标题
  title           String    @default("")
  /// 摘要
  excerpt         String    @default("")
  /// 正文内容哈希
  contentHash     String    @default("")
  /// 来源消息 ID
  sourceMessageId String?
  /// 所属访客作品集（M9-C1 expand：NULL 表示 legacy 未归属）
  collectionId    String?
  collection      GuestStoryCollection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  /// 集合内稳定顺序（同集合唯一）
  position        Int?
  /// 收藏时间
  favoritedAt     DateTime?
  /// 软删除时间
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  /// 每作品长期播放进度（per-Work 0/1；ownership 经本表 → guest，不重复存 guestId）
  progress        GuestStoryPlaybackProgress?
  /// M8 Canonical Audio Manifests（Guest 侧，与 User 对称；旧 Work 无 Manifest = audio.status missing，不回填）
  audioManifests  GuestStoryAudioManifest[]
  /// M9-C1 T3 单轨资产（Guest 侧，与 User 对称）
  audioAssets     GuestStoryAudioAsset[]
  /// M9-C1 T3 秒级播放进度（Guest 侧）
  audioProgress   GuestStoryAudioProgress?

  @@unique([guestId, sourceMessageId])
  @@unique([collectionId, position])
  @@unique([collectionId, sourceMessageId])
  @@index([guestId, createdAt, id])
  @@index([guestId, deletedAt])
  @@index([guestId, favoritedAt])
  @@index([guestId])
  @@index([updatedAt])
  @@index([collectionId, position])
  @@map("GuestGenerationHistory")
}

/// 访客提示词历史
model GuestPromptHistory {
  id        Int      @id @default(autoincrement())
  guestId   String
  prompt    String
  lastUsed  DateTime
  useCount  Int      @default(1)
  updatedAt DateTime @updatedAt

  @@unique([guestId, prompt])
  @@index([guestId, lastUsed])
  @@index([guestId])
  @@index([updatedAt])
}

/// 用户当前播放锚点（逻辑名 UserPlaybackAnchor，物理表仍为 UserPlaybackProgress；每用户 0/1）
/// M5-02：逻辑 rename + sourceKind(@map sourceType) + anchorState；旧列/旧表全部保留，不做 SQLite rebuild。
model UserPlaybackAnchor {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 播放源种类：正式值 draft|work（物理列仍为 sourceType；兼容期同时接受 chat|generation，见 lib/playback/legacy.ts）
  sourceKind String @map("sourceType")
  /// 溯源唯一标识：draft 时为 ChatMessage.messageId，work 时为 String(StoryWork.id)；严禁 replay-text-* 临时 ID
  sourceId   String
  /// 会话标识（可选；M5 起为 UUID v4，legacy null 由 getAnchor repair）
  sessionId  String?
  /// 锚点 resting state：ready|ended（运行态 playing/synthesizing/error 不持久化；读后进 ready/ended，不 autoplay）
  anchorState String @default("ready")
  /// 故事展示标题（用于断点恢复首屏展示，避免异步查主表）
  title      String

  /// 正文内容哈希（基于规范化文本计算的 8-12 位短哈希，用于检测正文漂移）
  contentHash         String @default("")
  /// 分段算法版本号（默认 'v1'，升级切段规则时可感知历史不兼容）
  segmentationVersion String @default("v1")

  /// 上一次已完整听完的段落序号（从 0 开始；-1 表示该故事未听完首段）
  lastCompletedParagraphIndex Int @default(-1)
  /// 下一次应当恢复播放的段落序号（通常为 lastCompletedParagraphIndex + 1，中途退出即重播此段）
  nextParagraphIndex          Int @default(0)
  /// 该故事正文总段落数
  totalParagraphs             Int @default(1)

  /// 合成语音参数上下文
  voiceId String @default("")
  speed   Float  @default(1.0)

  /// 倒计时上下文：继承定时器剩余有效毫秒数
  remainingAllowedMs Int?
  totalAllowedMs     Int?
  /// M7-03 Sleep Timer 三态：off|minutes|story_end（§22；story_end 仅 Work，§22.1）。
  /// Legacy 行由 migration 按 remainingAllowedMs 回填（非 null→minutes，null→off，§23.1），不得只依赖列 default。
  sleepTimerMode       String @default("minutes")
  /// Legacy compatibility; new domain logic不再读取（M5 起收敛为 continuationMode finite|extendable）
  isOneShot          Boolean @default(false)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("UserPlaybackProgress")
}

/// 访客当前播放锚点（逻辑名 GuestPlaybackAnchor，物理表仍为 GuestPlaybackProgress；每访客 0/1，30 天 GC 管辖）
/// M5-02：与 User 对称设计；旧列/旧表全部保留。
model GuestPlaybackAnchor {
  id      Int    @id @default(autoincrement())
  guestId String @unique

  /// 播放源种类：正式值 draft|work（物理列仍为 sourceType；兼容期同时接受 chat|generation）
  sourceKind String @map("sourceType")
  /// 溯源唯一标识：draft 时为 ChatMessage.messageId，work 时为 String(GuestStoryWork.id)；严禁 replay-text-* 临时 ID
  sourceId   String
  sessionId  String?
  /// 锚点 resting state：ready|ended
  anchorState String @default("ready")
  title      String

  contentHash         String @default("")
  segmentationVersion String @default("v1")

  lastCompletedParagraphIndex Int @default(-1)
  nextParagraphIndex          Int @default(0)
  totalParagraphs             Int @default(1)

  voiceId String @default("")
  speed   Float  @default(1.0)

  remainingAllowedMs Int?
  totalAllowedMs     Int?
  /// M7-03 Sleep Timer 三态：off|minutes|story_end（§22；Guest 与 User 对称）
  sleepTimerMode       String @default("minutes")
  /// Legacy compatibility; new domain logic不再读取
  isOneShot          Boolean @default(false)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([guestId])
  @@index([updatedAt])
  @@map("GuestPlaybackProgress")
}

/// 用户每作品长期播放进度（per-Work 0/1；ownership 经 StoryWork → User，不重复存 userId，见 §6.2）
/// 秒级 offset 不记录，恢复到 paragraph 开头（§6.3）；status 由 next/total 推导，不另存（§7）。
model StoryPlaybackProgress {
  id Int @id @default(autoincrement())

  storyWorkId Int @unique
  storyWork   StoryWork @relation(fields: [storyWorkId], references: [id], onDelete: Cascade)

  contentHash         String @default("")
  segmentationVersion String @default("v1")

  lastCompletedParagraphIndex Int @default(-1)
  nextParagraphIndex          Int @default(0)
  totalParagraphs             Int @default(1)

  completedAt DateTime?
  lastPlayedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastPlayedAt])
}

/// 访客每作品长期播放进度（per-Work 0/1；ownership 经 GuestStoryWork → guest，不重复存 guestId）
/// Work FK cascade 为主，Guest GC 清理 GuestStoryWork 时级联删除（见 lib/server/guestGc.ts）。
model GuestStoryPlaybackProgress {
  id Int @id @default(autoincrement())

  storyWorkId Int @unique
  storyWork   GuestStoryWork @relation(fields: [storyWorkId], references: [id], onDelete: Cascade)

  contentHash         String @default("")
  segmentationVersion String @default("v1")

  lastCompletedParagraphIndex Int @default(-1)
  nextParagraphIndex          Int @default(0)
  totalParagraphs             Int @default(1)

  completedAt DateTime?
  lastPlayedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastPlayedAt])
  @@index([updatedAt])
}

/// 访客作品注册迁移记录表（映射 guestStoryWorkId → userStoryWorkId，供 legacy playback 引用映射及持久追溯）
model StoryWorkMigration {
  id               Int      @id @default(autoincrement())
  guestId          String
  userId           Int
  guestStoryWorkId Int
  userStoryWorkId  Int
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([guestId, guestStoryWorkId])
  @@index([guestId])
  @@index([userId])
  @@index([guestStoryWorkId])
  @@index([userStoryWorkId])
  @@map("StoryWorkMigration")
}

/// M8 Canonical Audio Manifest（User 侧，spec §5.1/§5.2；M8-01 expand-only：只建表，零历史回填）。
/// identity = contentHash + segmentationVersion + voiceId + ttsBackendId + ttsModel
///   + synthesisVersion + audioFormat + synthesisSpeed(=1.0 冻结)；用户 playbackRate/title/favorite 不进入。
/// 旧 StoryWork 无 Manifest 行，M2 投影一律 audio.status=missing（spec §37）。
model StoryAudioManifest {
  id Int @id @default(autoincrement())

  storyWorkId Int
  storyWork   StoryWork @relation(fields: [storyWorkId], references: [id], onDelete: Cascade)

  /// Manifest 世代（正常恒为 1；为未来 Revoice/TTS 迁移/重生成预留，旧版以 supersededAt 标记）
  version Int @default(1)

  /// Manifest 级四态：missing | preparing | ready | failed（spec §12.2）
  status String @default("missing")

  /// 冻结的正文身份（创建时自 StoryWork 快照，之后不再跟随正文/切段算法变化）
  contentHash         String
  segmentationVersion String

  /// 冻结的声音身份（Work.voiceId 优先；legacy 空串则 resolve 默认 voice 后冻结，spec §8）
  voiceId String

  /// 冻结的 TTS 身份（backend 显式 identity，非 secret；model 为 Manifest authoritative pin，spec §5.3/§9）
  ttsBackendId String
  ttsModel     String

  /// 合成管线版本（应用自定 canonical-mp3-v1，语义变化时 bump，spec §5.4）
  synthesisVersion String
  /// Canonical 合成速度恒为 1.0（用户倍速由播放器 playbackRate 实现，spec §7）
  synthesisSpeed   Float  @default(1.0)
  audioFormat      String @default("mp3")

  segmentCount      Int
  readySegmentCount Int @default(0)

  /// 仅全部 Segment ready 后写入 sum(segment.durationMs)（spec §17.1）
  totalDurationMs Int?
  totalByteLength Int?

  lastErrorCode String?

  readyAt      DateTime?
  supersededAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  segments StoryAudioSegment[]

  @@unique([storyWorkId, version])
  @@index([storyWorkId, status])
  @@index([status, updatedAt])
}

/// M8 Canonical Audio Segment（User 侧，spec §6；text 为 frozen input，Manifest 创建时持久化）。
/// id 由 service 经 crypto.randomUUID() 显式生成（server-generated UUID，spec §6.1），不编码任何业务身份；
/// storageKey 为 opaque asset key（story-audio/<uuid>.mp3），不编码 User/Guest/Work/title（spec §6.2/§6.3）。
model StoryAudioSegment {
  /// Server 生成的不透明公开 ID（UUID v4 文本；DB 无默认，强制 service 显式生成）
  id String @id

  manifestId Int
  manifest   StoryAudioManifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)

  segmentIndex Int

  /// 冻结的段文本与其哈希（textHash 沿用既有 computeStoryContentHash，不另造正文 hash，spec §6.4/§6.5）
  text     String
  textHash String

  /// Segment 四态：missing → preparing → ready；失败 preparing → failed → retry preparing（spec §12.1）
  status String @default("missing")

  /// Opaque 对象 key，全局唯一；浏览器永不直接获取（spec §6.2/§33）
  storageKey String @unique

  contentType String @default("audio/mpeg")
  byteLength  Int?
  durationMs  Int?

  /// SHA-256(audio bytes) blob 完整性（与 contentHash 正文身份严格区分，spec §6.6）
  audioChecksum String?

  /// 并发 synthesis 租约（claim 后在事务外调用 TTS，严禁持 SQLite 写锁等网络，spec §15）
  leaseId        String?
  leaseExpiresAt DateTime?

  attemptCount  Int @default(0)
  lastErrorCode String?

  readyAt   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([manifestId, segmentIndex])
  @@index([manifestId, status])
  @@index([leaseExpiresAt])
}

/// M8 Canonical Audio Manifest（Guest 侧，与 StoryAudioManifest 结构对称；ownership 经 GuestStoryWork → guest）。
model GuestStoryAudioManifest {
  id Int @id @default(autoincrement())

  storyWorkId Int
  storyWork   GuestStoryWork @relation(fields: [storyWorkId], references: [id], onDelete: Cascade)

  version Int @default(1)

  status String @default("missing")

  contentHash         String
  segmentationVersion String

  voiceId String

  ttsBackendId String
  ttsModel     String

  synthesisVersion String
  synthesisSpeed   Float  @default(1.0)
  audioFormat      String @default("mp3")

  segmentCount      Int
  readySegmentCount Int @default(0)

  totalDurationMs Int?
  totalByteLength Int?

  lastErrorCode String?

  readyAt      DateTime?
  supersededAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  segments GuestStoryAudioSegment[]

  @@unique([storyWorkId, version])
  @@index([storyWorkId, status])
  @@index([status, updatedAt])
}

/// M8 Canonical Audio Segment（Guest 侧，与 StoryAudioSegment 结构对称；注册迁移时 transfer ownership，object bytes 不动，spec §27）。
model GuestStoryAudioSegment {
  id String @id

  manifestId Int
  manifest   GuestStoryAudioManifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)

  segmentIndex Int

  text     String
  textHash String

  status String @default("missing")

  storageKey String @unique

  contentType String @default("audio/mpeg")
  byteLength  Int?
  durationMs  Int?

  audioChecksum String?

  leaseId        String?
  leaseExpiresAt DateTime?

  attemptCount  Int @default(0)
  lastErrorCode String?

  readyAt   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([manifestId, segmentIndex])
  @@index([manifestId, status])
  @@index([leaseExpiresAt])
}

/// M8 Audio 对象删除 tombstone（spec §29；真删除工作流留 M8-05，本项只 expand 表结构）。
/// 永久删除 / Guest GC 先在同一 DB 事务内记 tombstone 再删 Work 行，外部清理成功后删 tombstone；
/// 清理失败则保留 tombstone 供 startup / 机会式 retry，避免永久 orphan。
model AudioStorageDeletion {
  id Int @id @default(autoincrement())

  storageKey String @unique

  attempts Int @default(0)

  nextAttemptAt DateTime?
  lastError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nextAttemptAt])
}

/// M9-C1 T3 StoryAudio 单轨资产（User 侧，spec §2/§4；expand-only：只加表，零历史回填）。
/// 一 Work 一 canonical track：内部 chunk 合成后拼接为一个 storageKey 对象；identity =
/// contentHash + voiceId + ttsProfileHash（provider/model/synthesisVersion/format 汇总）+ version。
/// chunk 为内部临时对象（story-audio/chunks/<assetId>/<i>.mp3），无读取路由、不写进度、不刷新 TTL。
model StoryAudioAsset {
  /// Server 生成的不透明公开 ID（UUID v4 文本；DB 无默认，强制 service 显式生成）
  id String @id

  storyWorkId Int
  storyWork   StoryWork @relation(fields: [storyWorkId], references: [id], onDelete: Cascade)

  /// 资产世代（正常恒 1；为未来 Revoice/重建预留，旧版以 supersededAt 标记）
  version Int @default(1)

  /// 四态：missing | preparing | ready | failed
  status String @default("missing")

  contentHash     String
  voiceId         String
  ttsProfileHash  String
  synthesisVersion String
  audioFormat     String @default("mp3")

  /// 内部 chunk 数（合成计划长度；全成功后拼接为单对象）
  chunkCount Int

  /// Opaque 发布对象 key（story-audio/<uuid>.mp3），全局唯一；浏览器永不直接获取
  storageKey  String @unique
  contentType String @default("audio/mpeg")
  byteLength  Int?
  durationMs  Int?
  checksum    String?

  /// 并发合成租约（claim 后事务外调用 TTS/拼装，严禁持 SQLite 写锁做网络/IO）
  leaseId        String?
  leaseExpiresAt DateTime?

  /// 30 天滑动 TTL 锚点（授权读取限频刷新；spec §4）
  lastAccessedAt DateTime?

  attemptCount  Int @default(0)
  lastErrorCode String?

  readyAt      DateTime?
  supersededAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storyWorkId, version])
  @@index([storyWorkId, status])
  @@index([status, lastAccessedAt])
  @@index([leaseExpiresAt])
}

/// M9-C1 T3 StoryAudio 单轨资产（Guest 侧，与 StoryAudioAsset 结构对称）。
model GuestStoryAudioAsset {
  id String @id

  storyWorkId Int
  storyWork   GuestStoryWork @relation(fields: [storyWorkId], references: [id], onDelete: Cascade)

  version Int @default(1)

  status String @default("missing")

  contentHash      String
  voiceId          String
  ttsProfileHash   String
  synthesisVersion String
  audioFormat      String @default("mp3")

  chunkCount Int

  storageKey  String @unique
  contentType String @default("audio/mpeg")
  byteLength  Int?
  durationMs  Int?
  checksum    String?

  leaseId        String?
  leaseExpiresAt DateTime?

  lastAccessedAt DateTime?

  attemptCount  Int @default(0)
  lastErrorCode String?

  readyAt      DateTime?
  supersededAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storyWorkId, version])
  @@index([storyWorkId, status])
  @@index([status, lastAccessedAt])
  @@index([leaseExpiresAt])
}

/// M9-C1 T3 每 Work 秒级播放进度（User 侧，spec §4；positionMs 节流落库，服务端 sessionId + 单调守卫）。
model StoryAudioProgress {
  id Int @id @default(autoincrement())

  storyWorkId Int @unique
  storyWork   StoryWork @relation(fields: [storyWorkId], references: [id], onDelete: Cascade)

  positionMs Int @default(0)
  durationMs Int?
  sessionId  String @default("")

  completedAt  DateTime?
  lastPlayedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastPlayedAt])
}

/// M9-C1 T3 每 Work 秒级播放进度（Guest 侧，与 StoryAudioProgress 对称）。
model GuestStoryAudioProgress {
  id Int @id @default(autoincrement())

  storyWorkId Int @unique
  storyWork   GuestStoryWork @relation(fields: [storyWorkId], references: [id], onDelete: Cascade)

  positionMs Int @default(0)
  durationMs Int?
  sessionId  String @default("")

  completedAt  DateTime?
  lastPlayedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastPlayedAt])
  @@index([updatedAt])
}

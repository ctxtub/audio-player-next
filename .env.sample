# 数据库配置
# 本地开发使用相对路径，Docker 生产环境使用 /app/data/app.db
DATABASE_URL="file:./prisma/dev.db"

# Cookie 会话签名密钥（必填项，生产环境请设置高强度随机字符串）
SESSION_SECRET=your-session-secret-here

# 服务端 HTTP 客户端的默认超时时间（毫秒）
HTTP_SERVER_TIMEOUT_MS=120_000

# OpenAI 配置（必填项）
OPENAI_API_KEY=sk-your-key
# 故事生成专用模型
OPENAI_MODEL_STORY=gpt-4o
# Agent 流程专用模型
OPENAI_MODEL_AGENT=gpt-4o-mini
# 可选：自定义 OpenAI Base URL（如走代理时需要），默认无需填写
# OPENAI_BASE_URL=https://api.openai.com/v1
# 可选：默认采样温度
# OPENAI_TEMPERATURE=0.7
# 可选：默认最大输出 token 数
# OPENAI_MAX_TOKENS=1024

# OpenAI TTS 语音合成配置
# TTS 模型名称，支持 tts-1（快速）或 tts-1-hd（高质量），默认 tts-1
OPENAI_TTS_MODEL=tts-1
# 语音白名单，需为 JSON 数组，支持的语音：alloy, echo, fable, onyx, nova, shimmer
OPENAI_TTS_VOICE_LIST=[{"value":"alloy","label":"Alloy","description":"中性、平衡"},{"value":"nova","label":"Nova","description":"女性、活泼"},{"value":"shimmer","label":"Shimmer","description":"女性、温暖"}]
# 默认语音 ID，必须出现在白名单 value 列表中
OPENAI_TTS_DEFAULT_VOICE=alloy

# LangSmith Tracing 配置（可选）
# 开启 LangChain Tracing V2
LANGCHAIN_TRACING_V2=true
# LangSmith API Endpoint
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
# LangSmith API Key
LANGCHAIN_API_KEY=lsv2_...
# LangSmith 项目名称
LANGCHAIN_PROJECT=audio-player-next

# Canonical Audio 存储配置（bytes 放哪里 + 授权读取；不负责生成资产）
# 二选一 canonical backend（local|S3），不是双写、不做 Hot Cache
AUDIO_STORAGE_DRIVER=local
# Local backend 根目录（独立 volume，与 SQLite 的 /app/data 解耦；禁止落入 /app/data/audio）
AUDIO_LOCAL_ROOT=/app/audio
# S3-compatible backend（driver=s3 时必填；bucket 恒为 private，禁止公开 ACL）
# AUDIO_S3_ENDPOINT=https://s3.example.com
# AUDIO_S3_REGION=us-east-1
# AUDIO_S3_BUCKET=audio-canonical-private
# AUDIO_S3_ACCESS_KEY_ID=
# AUDIO_S3_SECRET_ACCESS_KEY=
# 路径风格寻址（MinIO 等自托管 S3 设 true；AWS S3 保持 false）
# AUDIO_S3_FORCE_PATH_STYLE=false
# 短时签名 URL TTL（秒，默认 900）
# AUDIO_SIGNED_URL_TTL_SECONDS=900

# Canonical Audio 生产启用门（fail-closed：缺省/空/非法值一律关闭，
# 仅严格 '1' 开启；"Production enable" = 具备安全开启能力，不是默认强开）
# 构建期变量（供 Next 构建内联到 client；docker compose build 时经 build.args 传入；
# 浏览器 provider 的 production rollout 必须在 build 时设置 NEXT_PUBLIC_CANONICAL_AUDIO_ENABLED=1）：
# NEXT_PUBLIC_CANONICAL_AUDIO_ENABLED=
# 运行时变量（server/node 侧读取；docker compose environment 传入；server 兼容可保留，
# 但不能替代 client build flag，不得描述为单独足够开启生产播放）：
# CANONICAL_AUDIO_ENABLED=
# 关闭时 playback 读路径永不调用 ensureSegment，不产生新的 canonical 写入。